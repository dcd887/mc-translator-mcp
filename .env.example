# .env.example — 复制为 .env 并填写
#
# mc-translator-mcp 不绑定任何特定 AI 供应商。任选一种方式配置即可，
# 检测到哪个 key 就用哪个，优先级：custom > agnes > dashscope（可选 DeepSeek 兜底）。

# ---- 方式 A（推荐，最通用）：自定义 OpenAI 兼容供应商 ----
# 任意提供 OpenAI 兼容接口的平台都可用，填你的 key / 网关地址 / 模型名
TRANSLATOR_API_KEY=
TRANSLATOR_BASE_URL=
TRANSLATOR_MODEL=

# ---- 方式 B：agnes ai（只要有对应的 key 就生效）----
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# ---- 方式 C：通义千问（阿里云百炼）----
# API Key 申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# ---- 方式 D：DeepSeek（可选，仅作主供应商失败时的 fallback）----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
USE_DEEPSEEK_FALLBACK=true

# ---- 通用参数 ----
BATCH_SIZE=15                 # 每批翻译词条数（建议 10-20，避免超长请求失败）
OUTPUT_DIR=output             # 资源包输出根目录
CACHE_FILE=translator_cache.json  # 翻译缓存文件